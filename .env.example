# Supabase — connection strings + API keys from Project Settings
DATABASE_URL=
DATABASE_POOLER_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firecrawl — API key for scraping and extraction
FIRECRAWL_API_KEY=

# Inngest — event + signing keys for orchestration (Phase 1.5)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Alerts — optional Discord/Slack-compatible webhook for the daily health-check.
# If unset, the health-check function logs its summary to stdout (visible in the
# Inngest dashboard run output). Set this to a Discord channel webhook URL to get
# alerts when a source goes stale / errors / returns zero promos.
#   Discord:  https://discord.com/api/webhooks/<id>/<token>
#   Slack:    https://hooks.slack.com/services/<team>/<channel>/<token>
ALERT_WEBHOOK_URL=

# Google AI (Gemini) — structured extraction for Phase 1+
GEMINI_API_KEY=
GCP_PROJECT_ID=
